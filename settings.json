{
  "tokenReducer": {
    "chunkSizeWords": 100,
    "chunkOverlapWords": 20,
    "chunkSizeMinWords": 80,
    "chunkSizeMaxWords": 300,
    "defaultTopK": 3,
    "relevanceFloor": 0.18,
    "embeddingDimensions": 256,
    "embeddingBackend": "ml",
    "embeddingModel": "jinaai/jina-embeddings-v2-base-code",
    "embeddingFallbackBackend": "hash",
    "ftsCandidateCount": 12,
    "vectorCandidateCount": 10,
    "hybridMode": "fallback",
    "bm25Enabled": true,
    "annEngine": "hnsw",
    "annEfSearch": 160,
    "annEfConstruction": 200,
    "annM": 16,
    "minFinalContexts": 3,
    "maxFinalContexts": 3,
    "compressionWordBudget": 150,
    "compressionMaxSelectedRatio": 0.6,
    "queryCacheTtlSeconds": 900,
    "sessionMemoryEnabled": true,
    "maxQueryWords": 500,
    "maxQueryLines": 80,
    "historyCompactReminderTurns": [8, 10, 12, 18, 24, 30, 36, 42],
    "preferFtsFirst": true,
    "vectorFallbackMinFtsHits": 3,
    "context7Optional": true,
    "maxFileSizeBytes": 524288,
    "hardTruncateWords": 1500,
    "hardBlockWords": 3000,
    "astChunkingEnabled": true,
    "hashEmbeddingSkipVector": true,
    "semanticClusteringEnabled": true,
    "semanticClusterCount": 5,
    "textRankEnabled": true,
    "textRankDamping": 0.85,
    "textRankIterations": 30,
    "embeddingApiEndpoint": "http://localhost:11434",
    "pageRankEnabled": true,
    "lspFeatures": {
      "importGraphEnabled": true,
      "twoHopExpansionEnabled": false,
      "twoHopMaxExpansions": 5,
      "importedContextLimit": 2,
      "symbolIndexEnabled": true,
      "diffProtocolEnabled": true
    },
    "scoringWeights": {
      "ftsLexicalRankWeight": 0.35,
      "ftsBm25Weight": 0.65,
      "finalFtsWeight": 0.50,
      "finalVectorWeight": 0.35,
      "finalOverlapWeight": 0.15,
      "sentenceLengthBonusWeight": 0.10,
      "sentenceLengthNormalizer": 24.0,
      "charNgramWeight": 0.35,
      "textRankWeight": 0.50,
      "queryRelevanceWeight": 0.35,
      "importedFileBoost": 1.25,
      "pageRankBoostWeight": 0.10
    },
    "embeddingCache": {
      "maxSize": 10000,
      "ttlSeconds": 86400,
      "strategy": "lru"
    }
  },
  "promptGuard": {
    "autoCompactTurn": 10,
    "autoResetTurn": 40,
    "criticalResetTurn": 50,
    "reminderTurns": [5, 8, 10, 12, 15, 20, 28, 36]
  }
}
